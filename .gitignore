logs/
*.log
*.log.*

# IDE and Editor Files
.idea/
*.iml
.vscode/
.settings/
.project
.classpath
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Local Repository Storage (Generated at runtime by FileRepository)
data/storage/
data/runtime/
